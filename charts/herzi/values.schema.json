{
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "goMemLimit": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "properties": {}
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "metricsReader": {
          "type": "object",
          "properties": {
            "subjects": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "interval": {
          "type": "string",
          "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
        },
        "reconcileTimeout": {
          "type": "string",
          "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
        },
        "mceName": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "agentNamespace": {
          "type": "string"
        },
        "installURL": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://[^/\\s]+.*$"
        },
        "maxSlots": {
          "type": "integer",
          "const": 100
        },
        "ambiguousWait": {
          "type": "string",
          "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
        },
        "stuckAfter": {
          "type": "string",
          "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
        },
        "temporalAddress": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "temporalNamespace": {
          "type": "string"
        },
        "activityQueue": {
          "type": "string"
        },
        "workflowQueue": {
          "type": "string"
        },
        "segmentQueue": {
          "type": "string"
        },
        "defaults": {
          "type": "object",
          "properties": {
            "highPct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "minFree": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "maxOpenRunsPerPool": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "probeInterval": {
              "type": "string",
              "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
            },
            "drawGrace": {
              "type": "string",
              "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
            },
            "failureMemory": {
              "type": "string",
              "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
            },
            "settlingMax": {
              "type": "string",
              "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
            },
            "dryRunGrow": {
              "type": "boolean"
            },
            "paused": {
              "type": "boolean"
            },
            "lowPct": {
              "description": "lowPct was removed; delete lowPct",
              "allOf": [
                {
                  "enum": [
                    "lowPct was removed; delete lowPct"
                  ]
                },
                {
                  "not": {}
                }
              ]
            },
            "minBand": {
              "description": "minBand was removed; delete minBand",
              "allOf": [
                {
                  "enum": [
                    "minBand was removed; delete minBand"
                  ]
                },
                {
                  "not": {}
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "pools": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "highPct": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "minFree": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "maxOpenRunsPerPool": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "probeInterval": {
                "type": "string",
                "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
              },
              "drawGrace": {
                "type": "string",
                "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
              },
              "failureMemory": {
                "type": "string",
                "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
              },
              "settlingMax": {
                "type": "string",
                "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
              },
              "dryRunGrow": {
                "type": "boolean"
              },
              "paused": {
                "type": "boolean"
              },
              "lowPct": {
                "description": "lowPct was removed; delete lowPct",
                "allOf": [
                  {
                    "enum": [
                      "lowPct was removed; delete lowPct"
                    ]
                  },
                  {
                    "not": {}
                  }
                ]
              },
              "minBand": {
                "description": "minBand was removed; delete minBand",
                "allOf": [
                  {
                    "enum": [
                      "minBand was removed; delete minBand"
                    ]
                  },
                  {
                    "not": {}
                  }
                ]
              },
              "exclude": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "ignoreLabel": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "required": [
        "mceName",
        "installURL",
        "temporalAddress"
      ]
    },
    "temporal": {
      "type": "object",
      "properties": {
        "tls": {
          "type": "object",
          "properties": {
            "caCert": {
              "type": "string",
              "pattern": "^$|^\\s*-----BEGIN CERTIFICATE-----"
            },
            "existingSecret": {
              "type": "string"
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "if": {
            "required": [
              "caCert"
            ],
            "properties": {
              "caCert": {
                "minLength": 1
              }
            }
          },
          "then": {
            "properties": {
              "existingSecret": {
                "maxLength": 0,
                "description": "set caCert or existingSecret, not both"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "properties": {}
        },
        "endpoint": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "properties": {}
        }
      },
      "additionalProperties": false
    },
    "nodeSelector": {
      "type": "object",
      "properties": {}
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object",
      "properties": {}
    },
    "podAnnotations": {
      "type": "object",
      "properties": {}
    },
    "podLabels": {
      "type": "object",
      "properties": {}
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "extraArgs": {
      "type": "array"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false
}
